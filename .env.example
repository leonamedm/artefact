# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible chat endpoint works (ADR-0002). All options below are free.

# Option A (default) — Google Gemini free tier. Key (no credit card): https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-flash-latest
LLM_API_KEY=

# Option B — Groq free tier. Key: https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=

# Option C — local Ollama (no key, runs offline; needs a tool-calling model pulled locally)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=ollama

# Optional
# LLM_TEMPERATURE=0.2
