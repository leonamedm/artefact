# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible chat endpoint works (ADR-0002). All options below are free.

# Option A (default) — Google Gemini free tier. Key (no credit card): https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=

# Option B — Groq free tier. Key: https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=

# Option C — local Ollama (no key, runs offline; needs a tool-calling model pulled locally)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=ollama

# Optional
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT=60            # seconds per request (default for every provider)

# --- Several providers with automatic fallback (ADR-0007) ---------------------------------
# Numbered entries replace the single set above; the number is the fallback order and only
# enabled entries are used. Manage them with `uv run emporio-admin` (list/test/add/set/
# enable/disable/move/remove) instead of editing by hand. Example:
# LLM_1_NAME=gemini
# LLM_1_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_1_MODEL=gemini-3.5-flash-lite
# LLM_1_API_KEY=
# LLM_1_TIMEOUT=60
# LLM_1_ENABLED=true
# LLM_2_NAME=ollama-qwen3-4b
# LLM_2_BASE_URL=http://localhost:11434/v1
# LLM_2_MODEL=qwen3:4b       # fits an 8 GB Mac; qwen3:8b needs more free RAM
# LLM_2_API_KEY=ollama
# LLM_2_TIMEOUT=300          # local models are slow; a short timeout would cut them off
# LLM_2_ENABLED=true
